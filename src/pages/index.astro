---
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Intro from '../components/Intro.astro';
import Projects from '../components/Projects.astro';
import RowList from '../components/RowList.astro';
import Stack from '../components/Stack.astro';
import Now from '../components/Now.astro';
import SocialBar from '../components/SocialBar.astro';

const experiences = [
  { mark: 'PL', primary: 'Finance Team Member', secondary: 'PPI Liverpool', meta: 'Current' },
  {
    mark: 'IL',
    primary: 'Assistant Photography Intern',
    secondary: 'ILUMINEN, Bali',
    meta: '2022 — 2024',
  },
  {
    mark: 'MC',
    primary: 'Information Technology Intern',
    secondary: 'Murni Cosmetics, Bali',
    meta: 'Dec 2022',
  },
  {
    mark: 'RS',
    primary: 'Production House Documentation',
    secondary: 'Regents School, Bali',
    meta: '2022 — 2023',
  },
];

const education = [
  {
    mark: 'UL',
    primary: 'BSc Computer Science (Year in Industry)',
    secondary: 'University of Liverpool',
    meta: '2024 — 2028',
  },
];
---

<Base>
  <div class="relative min-h-screen px-6 pb-7">
    <ThemeToggle />

    <main id="main" class="mx-auto max-w-[680px] pt-28">
      <Intro />
      <Projects />
      <RowList heading="Experiences" rows={experiences} />
      <RowList heading="Education" rows={education} />
      <Stack />
      <Now />
    </main>

    <SocialBar />
  </div>
</Base>

<script>
  // One observer for every [data-reveal] on the page — the section headings and
  // the heatmap grid. The CSS default is the finished state, so if this never
  // runs the page still reads correctly; the class only triggers the animation.
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (targets.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-revealed');
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
