---
// 1200×630 source for public/og.png. Mirrors the homepage: identity line,
// the Space Grotesk headline with its Inter italic run, muted bio, mono footer.
// Regenerate after design changes — build, then screenshot dist/og/index.html
// at 1200×630 (building first avoids the dev toolbar landing in the capture).
import '../styles/global.css';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>OG card source — rasslab.dev</title>
  </head>
  <body class="bg-bg font-body text-ink">
    <main class="flex h-[630px] w-[1200px] flex-col justify-between overflow-hidden p-16">
      <div class="flex items-baseline justify-between font-mono text-[22px]">
        <span class="font-bold tracking-tight">RL<span class="text-accent">/</span></span>
        <span class="text-muted">rasslab.dev</span>
      </div>

      <div>
        <h1 class="font-display max-w-[1000px] text-[78px] leading-[1.1] font-medium tracking-[-0.03em]">
          Rassel builds <em class="font-body font-normal italic">careful</em> software.
        </h1>

        <p class="mt-9 max-w-[880px] text-[27px] leading-[1.5] text-muted">
          Computer Science at the University of Liverpool — cybersecurity specialism, Year in
          Industry. Four shipped projects, kept truthful by end-to-end tests.
        </p>
      </div>

      <div class="flex items-end justify-between font-mono text-[19px] tracking-[0.12em] uppercase">
        <p class="flex items-center gap-3">
          <!-- A plain dot, not .live-dot: that one blinks, and a screenshot can
               land on the invisible half of the keyframe. -->
          <span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
          <span class="text-accent">Seeking a 2026/27 placement</span>
        </p>
        <p class="text-muted">Liverpool, UK</p>
      </div>
    </main>
  </body>
</html>
