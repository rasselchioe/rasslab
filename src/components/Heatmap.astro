---
import { getContributions } from '../lib/contributions';

// Build-time only. Returns null without a GITHUB_TOKEN, or if GitHub is
// unreachable — in which case the card is dropped rather than faked.
const data = await getContributions();
const legend = [0, 1, 2, 3, 4];
---

{
  data && (
    <div class="mt-5 overflow-x-auto rounded-[10px] border border-faint bg-panel p-4">
      <div class="grid min-w-min auto-cols-[9px] grid-flow-col grid-rows-[repeat(7,9px)] gap-[3px]">
        {data.cells.map((c) =>
          c.label === null ? (
            <span class="hm-cell hm-pad" aria-hidden="true" />
          ) : (
            <span class={`hm-cell hm-${c.level}`} title={c.label} />
          ),
        )}
      </div>

      <div class="mt-3 flex items-center justify-between gap-4 font-mono text-[10px] tracking-[0.08em] text-muted">
        <span>{data.total.toLocaleString('en-GB')} CONTRIBUTIONS IN THE LAST YEAR</span>
        <span class="flex items-center gap-1.5">
          <span>LESS</span>
          {legend.map((l) => (
            <span class={`hm-cell hm-${l}`} aria-hidden="true" />
          ))}
          <span>MORE</span>
        </span>
      </div>
    </div>
  )
}
