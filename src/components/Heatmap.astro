---
import { getContributions } from '../lib/contributions';

// Build-time only. Returns null without a GITHUB_TOKEN, or if GitHub is
// unreachable — in which case the card is dropped rather than faked.
const data = await getContributions();

// Only lit cells pop: with a sparse calendar, animating the empty ones would
// spend the whole reveal drawing the eye across nothing.
//
// The stagger is spread over the lit cells by rank, not by column position.
// Bucketing by column collapses the cascade whenever activity clusters in one
// stretch of the year — which is exactly what this calendar looks like. Cells
// are already in date order, so rank order still reads left to right.
const BUCKETS = 8;
const litOrder = new Map<number, number>();
data?.cells.forEach((c, i) => {
  if (c.label !== null && c.level > 0) litOrder.set(i, litOrder.size);
});
const bucket = (i: number) =>
  Math.min(BUCKETS - 1, Math.floor(((litOrder.get(i) ?? 0) / Math.max(1, litOrder.size)) * BUCKETS));
---

{
  data && (
    <div class="mt-5 overflow-x-auto rounded-[10px] border border-faint bg-panel p-4">
      <div
        class="hm-grid grid min-w-min auto-cols-[9px] grid-flow-col grid-rows-[repeat(7,9px)] gap-[3px]"
        data-reveal
      >
        {data.cells.map((c, i) =>
          c.label === null ? (
            <span class="hm-cell hm-pad" aria-hidden="true" />
          ) : (
            <span
              class={`hm-cell hm-${c.level}${c.level > 0 ? ` hm-p${bucket(i)}` : ''}`}
              title={c.label}
            />
          ),
        )}
      </div>

      <p class="mt-3 font-mono text-[10px] tracking-[0.08em] text-muted">
        {data.total.toLocaleString('en-GB')} CONTRIBUTIONS IN THE LAST YEAR
      </p>
    </div>
  )
}
