---
import { projects } from '../data/projects';
import Heatmap from './Heatmap.astro';
---

<section class="mt-10">
  <h2 data-reveal class="font-mono text-[11px] font-normal tracking-[0.16em] text-muted uppercase">Projects</h2>

  <Heatmap />

  <div class="mt-[22px] flex flex-col">
    {
      projects.map((p) => {
        // Each destination is its own link, so "Live · GitHub" is two targets
        // rather than one ambiguous label. The title's link is stretched over
        // the row (see .row-link in global.css) to keep the design's
        // click-anywhere behaviour; the meta links sit above it.
        const primary = p.links[0];

        return (
          <div
            class:list={[
              'project-row -mx-3 grid grid-cols-[34px_1fr_auto] items-baseline gap-4 rounded-lg px-3 py-[14px] transition-colors duration-200 hover:bg-panel',
              primary && 'is-link',
            ]}
          >
            <span class="row-num font-mono text-[12px] text-muted">
              <span class="row-num-face">{p.n}</span>
              <span class="row-num-alt" aria-hidden="true">
                ↗
              </span>
            </span>

            <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
              {primary ? (
                <a
                  class="row-link font-display text-[16px] font-medium text-ink"
                  href={primary.href}
                  target="_blank"
                  rel="noopener"
                >
                  {p.title}
                </a>
              ) : (
                <span class="font-display text-[16px] font-medium text-ink">{p.title}</span>
              )}
              <span class="text-[14px] text-muted">{p.sub}</span>
            </span>

            <span class="font-mono text-[11px] tracking-[0.08em] whitespace-nowrap text-muted">
              {p.links.length
                ? p.links.map((l) => (
                    <a class="meta-link" href={l.href} target="_blank" rel="noopener">
                      {l.label}
                    </a>
                  ))
                : p.note && 'Private'}
            </span>
          </div>
        );
      })
    }
  </div>
</section>
