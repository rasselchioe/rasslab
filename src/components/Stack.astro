---
const stack = [
  'TypeScript',
  'JavaScript',
  'Python',
  'Java',
  'React',
  'Next.js',
  'Astro',
  'Tailwind',
  'Node',
  'Express',
  'Prisma',
  'PostgreSQL',
  'Playwright',
  'Linux',
  'Cloudflare',
];
---

<section class="mt-[52px]">
  <h2 class="font-mono text-[11px] font-normal tracking-[0.16em] text-muted uppercase">Stack</h2>

  <ul class="mt-5 flex flex-wrap gap-2">
    {
      stack.map((s) => (
        <li class="rounded-full border border-faint px-3 py-1.5 font-mono text-[11.5px] tracking-[0.04em] text-muted">
          {s}
        </li>
      ))
    }
  </ul>
</section>
