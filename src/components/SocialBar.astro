<div data-social-sentinel class="h-px" aria-hidden="true"></div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-social-bar]');
  const sentinel = document.querySelector<HTMLElement>('[data-social-sentinel]');

  if (bar && sentinel) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry?.isIntersecting) bar.setAttribute('data-settled', '');
        else bar.removeAttribute('data-settled');
      },
      { threshold: 1 },
    );
    io.observe(sentinel);
  }
</script>
